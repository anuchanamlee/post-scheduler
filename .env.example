# ── ฐานข้อมูล ──────────────────────────────────────────────
DATABASE_URL=postgres://app:app@db:5432/scheduler

# ── URL สาธารณะ ────────────────────────────────────────────
# Instagram ต้องเข้าถึง image_url ได้จากอินเทอร์เน็ตจริง (รายงานข้อ B2)
# localhost ใช้ได้เฉพาะกับ provider แบบ mock เท่านั้น
# ของจริงต้อง tunnel: cloudflared tunnel --url http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
STORAGE_DIR=/data/storage

# ── ความปลอดภัย ────────────────────────────────────────────
ENCRYPTION_KEY_HEX=
ENCRYPTION_KEY_VERSION=1
CRON_SECRET=

# ── ปลายทาง ────────────────────────────────────────────────
# mock = ทดสอบทั้ง pipeline โดยไม่ต้องมี Meta App
# meta = ของจริง (ต้องมี META_APP_SECRET + System User token ในตาราง meta_credentials)
DEFAULT_PROVIDER=mock
META_GRAPH_VERSION=v26.0
# META_APP_SECRET=

# ── worker ────────────────────────────────────────────────
WORKER_INTERVAL_MS=15000
WORKER_GRACE_MINUTES=120

# ── ผู้ช่วยแคปชั่น + สร้างภาพ ───────────────────────────────
# key เดียวใช้ได้ทั้งสองอย่าง
# ไม่ตั้ง key = แคปชั่นร่างในเครื่อง (ยังอ่าน brand voice จริง)
#              ภาพได้เป็นภาพตัวอย่างไล่สี ไม่ใช่ผลจากโมเดล — ทั้งเส้นทางยังเดินครบ
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# โมเดลสร้างภาพ เรียกคนละ endpoint (/images) กับโมเดลข้อความ
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# 512 | 1K | 2K | 4K — 1K พอกับฟีด IG (1080px) และถูกกว่ากันหลายเท่า
OPENROUTER_IMAGE_RESOLUTION=1K

# แจ้งเตือนเข้า LINE (LINE Notify ปิดบริการแล้ว ใช้ Messaging API)
NOTIFY_TRANSPORT=mock
# WORKER_HEARTBEAT_URL=

# ที่เก็บไฟล์ — local ใช้ตอนพัฒนา, s3 ตอนโปรดักชัน (R2/B2/MinIO/S3)
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# เก็บ log ไว้กี่วัน (ของที่ระบบเขียนทิ้ง — โพสต์กับรูปไม่เคยถูกลบอัตโนมัติ)
RETAIN_JOB_RUNS_DAYS=7
RETAIN_API_LOG_DAYS=30
RETAIN_NOTIFICATION_DAYS=90
RETAIN_DRAFT_DAYS=90
